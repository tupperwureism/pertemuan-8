rules_version = '2';

// Sprint 2 - Security Rules (milik Programmer 1). Deny-by-default: koleksi tanpa match eksplisit ditolak.
// Role dibaca dari users/{uid}.role (di-provisikan PM untuk asisten); client tidak dapat menaikkan role.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ Helper

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAsisten() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.role == 'asisten';
    }

    function isAslab() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.role == 'aslab';
    }

    function isStaff() {
      return isAsisten() || isAslab();
    }

    function memberPath(classId) {
      return /databases/$(database)/documents/classMembers/$(classId + '_' + request.auth.uid);
    }

    function isMember(classId) {
      return signedIn() && exists(memberPath(classId));
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function classExists(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId));
    }

    function classData(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function isClassAsisten(classId) {
      return isAsisten()
        && classExists(classId)
        && request.auth.uid in classData(classId).assistantIds;
    }

    function attendancePath(sessionId, uid) {
      return /databases/$(database)/documents/attendances/$(sessionId + '_' + uid);
    }

    function permissionPath(sessionId, uid) {
      return /databases/$(database)/documents/permissions/$(sessionId + '_' + uid);
    }

    function labPath(labId) {
      return /databases/$(database)/documents/labs/$(labId);
    }

    function labExists(labId) {
      return exists(labPath(labId));
    }

    function labData(labId) {
      return get(labPath(labId)).data;
    }

    function shortText(value, maxLen) {
      return value is string && value.size() >= 1 && value.size() <= maxLen;
    }

    function validTransition(oldStatus, newStatus) {
      return oldStatus == newStatus
        || (oldStatus == 'BELUM_DIBUKA' && newStatus == 'DIBUKA')
        || (oldStatus == 'DIBUKA' && newStatus == 'DITUTUP');
    }

    // ------------------------------------------------------------- users

    match /users/{uid} {
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();

      // Registrasi publik: SELALU praktikan, ID = UID, email = email token Auth.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'nama', 'nomorInduk', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['uid', 'email', 'nama', 'nomorInduk', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'praktikan'
        && request.resource.data.email == request.auth.token.email
        && shortText(request.resource.data.nama, 100)
        && shortText(request.resource.data.nomorInduk, 30)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Pemilik hanya boleh mengubah nama/nomorInduk; role, uid, email, createdAt terkunci.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nama', 'nomorInduk', 'updatedAt'])
        && shortText(request.resource.data.nama, 100)
        && shortText(request.resource.data.nomorInduk, 30)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ----------------------------------------------------------- classes

    function validClassFields(data) {
      return data.keys().hasOnly(
               ['nama', 'mataPraktikum', 'kodeKelas', 'assistantIds', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(
               ['nama', 'mataPraktikum', 'kodeKelas', 'assistantIds', 'createdAt', 'updatedAt'])
        && shortText(data.nama, 100)
        && shortText(data.mataPraktikum, 100)
        && shortText(data.kodeKelas, 30)
        && data.assistantIds is list
        && data.assistantIds.size() >= 1
        && data.updatedAt == request.time;
    }

    match /classes/{classId} {
      allow read: if isAslab()
        || (isAsisten() && request.auth.uid in resource.data.assistantIds)
        || isMember(classId);

      allow create: if (isAslab() || isAsisten())
        && validClassFields(request.resource.data)
        && (isAslab() || request.auth.uid in request.resource.data.assistantIds)
        && request.resource.data.createdAt == request.time;

      allow update: if (isAslab() || isClassAsisten(classId))
        && validClassFields(request.resource.data)
        && (isAslab() || request.auth.uid in request.resource.data.assistantIds)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAslab() || isClassAsisten(classId);
    }

    // ------------------------------------------------------ classMembers

    match /classMembers/{memberId} {
      allow read: if isAslab()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || isClassAsisten(resource.data.classId);

      allow create: if (isAslab() || isClassAsisten(request.resource.data.classId))
        && request.resource.data.keys().hasOnly(['classId', 'uid', 'role', 'joinedAt'])
        && request.resource.data.keys().hasAll(['classId', 'uid', 'role', 'joinedAt'])
        && memberId == request.resource.data.classId + '_' + request.resource.data.uid
        && request.resource.data.role in ['praktikan', 'asisten', 'aslab']
        && exists(profilePath(request.resource.data.uid))
        && request.resource.data.joinedAt == request.time;

      allow update: if false;
      allow delete: if isAslab() || isClassAsisten(resource.data.classId);
    }

    // ---------------------------------------------------------- sessions

    function validSessionFields(data) {
      return data.keys().hasOnly(
               ['classId', 'judul', 'ruangan', 'labId', 'startsAt', 'endsAt', 'status', 'catatan',
                'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(
               ['classId', 'judul', 'ruangan', 'startsAt', 'endsAt', 'status', 'catatan',
                'createdBy', 'createdAt', 'updatedAt'])
        && shortText(data.judul, 150)
        && shortText(data.ruangan, 100)
        && (!('labId' in data) || data.labId == null || shortText(data.labId, 50))
        && data.catatan is string && data.catatan.size() <= 500
        && data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.endsAt > data.startsAt
        && data.status in ['BELUM_DIBUKA', 'DIBUKA', 'DITUTUP']
        && data.updatedAt == request.time;
    }

    match /sessions/{sessionId} {
      allow read: if isAslab()
        || isMember(resource.data.classId)
        || isClassAsisten(resource.data.classId);

      allow create: if (isAslab() || isClassAsisten(request.resource.data.classId))
        && validSessionFields(request.resource.data)
        && request.resource.data.status == 'BELUM_DIBUKA'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Status hanya maju: BELUM_DIBUKA -> DIBUKA -> DITUTUP. Identitas sesi terkunci.
      allow update: if (isAslab() || isClassAsisten(resource.data.classId))
        && validSessionFields(request.resource.data)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && validTransition(resource.data.status, request.resource.data.status);

      allow delete: if isAslab() || isClassAsisten(resource.data.classId);
    }

    // ------------------------------------------------------- attendances
    // ID = sessionId_uid. Praktikan create sekali ketika sesi DIBUKA; tidak ada update.
    // Ditolak bila praktikan memiliki izin PENDING/APPROVED pada sesi yang sama.
    // Bila sesi memiliki labId, wajib menyertakan koordinat + akurasi valid dalam radius lab.

    function hasNoAttendanceLocation(data) {
      return !('labId' in data)
        && !('latitude' in data)
        && !('longitude' in data)
        && !('accuracy' in data)
        && !('distanceMeter' in data);
    }

    function withinLabRadius(data, lab) {
      return data.distanceMeter >= 0
        && data.distanceMeter <= lab.radiusMeter * 1.05 + 5
        && math.sqrt(
             math.pow((data.latitude - lab.latitude) * 111320, 2)
             + math.pow((data.longitude - lab.longitude) * 111320 * lab.cosLat, 2)
           ) <= lab.radiusMeter * 1.05 + 5;
    }

    function validAttendanceForLab(data, sidLabId) {
      return labExists(sidLabId)
        && data.keys().hasAll(['labId', 'latitude', 'longitude', 'accuracy', 'distanceMeter'])
        && data.labId == sidLabId
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.distanceMeter is number
        && withinLabRadius(data, labData(sidLabId));
    }

    function validAttendanceSession(data, sess) {
      return sess.status == 'DIBUKA'
        && sess.classId == data.classId
        && (sess.get('labId', null) == null
            ? hasNoAttendanceLocation(data)
            : (sess.labId is string && validAttendanceForLab(data, sess.labId)));
    }

    function validAttendanceTimeliness(data) {
      return (!('timeliness' in data)
              || data.timeliness in ['TEPAT_WAKTU', 'TERLAMBAT'])
        && (!('lateMinutes' in data)
              || (data.lateMinutes is number && data.lateMinutes >= 0))
        && (!('gracePeriodMinutes' in data)
              || (data.gracePeriodMinutes is number
                  && data.gracePeriodMinutes >= 0
                  && data.gracePeriodMinutes <= 180));
    }

    match /attendances/{attendanceId} {
      allow read: if isAslab()
        || (signedIn() && resource.data.praktikanUid == request.auth.uid)
        || isClassAsisten(resource.data.classId);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['sessionId', 'classId', 'praktikanUid', 'attendedAt', 'catatan',
              'labId', 'latitude', 'longitude', 'accuracy', 'distanceMeter',
              'timeliness', 'lateMinutes', 'gracePeriodMinutes'])
        && request.resource.data.keys().hasAll(
             ['sessionId', 'classId', 'praktikanUid', 'attendedAt'])
        && request.resource.data.praktikanUid == request.auth.uid
        && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.attendedAt == request.time
        && (!('catatan' in request.resource.data)
            || (request.resource.data.catatan is string
                && request.resource.data.catatan.size() <= 500))
        && validAttendanceTimeliness(request.resource.data)
        && validAttendanceSession(request.resource.data, sessionData(request.resource.data.sessionId))
        && isMember(request.resource.data.classId)
        && (!exists(permissionPath(request.resource.data.sessionId, request.auth.uid))
            || get(permissionPath(request.resource.data.sessionId, request.auth.uid)).data.status == 'REJECTED');

      allow update: if false;
      // Asisten kelas boleh menghapus hanya untuk pembersihan data (mis. sesi dihapus).
      allow delete: if isClassAsisten(resource.data.classId);
    }

    // ------------------------------------------------------- permissions
    // ID = sessionId_uid. Praktikan create/baca miliknya dan hanya mengisi hasil klasifikasi AI;
    // ditolak bila sudah tercatat hadir. Keputusan APPROVED/REJECTED hanya oleh asisten kelas.

    function validAiFields(data) {
      return data.aiStatus in ['PENDING', 'SUCCEEDED', 'FAILED']
        && (data.get('aiLabel', null) == null
            || (data.aiLabel is string && data.aiLabel.size() <= 100))
        && (data.get('aiConfidence', null) == null
            || ((data.aiConfidence is number) && data.aiConfidence >= 0 && data.aiConfidence <= 1));
    }

    match /permissions/{permissionId} {
      allow read: if isAslab()
        || (signedIn() && resource.data.praktikanUid == request.auth.uid)
        || isClassAsisten(resource.data.classId);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['sessionId', 'classId', 'praktikanUid', 'alasan', 'aiStatus', 'aiLabel',
              'aiConfidence', 'status', 'reviewedBy', 'reviewedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['sessionId', 'classId', 'praktikanUid', 'alasan', 'aiStatus', 'status',
              'createdAt', 'updatedAt'])
        && request.resource.data.praktikanUid == request.auth.uid
        && permissionId == request.resource.data.sessionId + '_' + request.auth.uid
        && shortText(request.resource.data.alasan, 1000)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.aiStatus == 'PENDING'
        && validAiFields(request.resource.data)
        && (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == null)
        && (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == null)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && sessionData(request.resource.data.sessionId).classId == request.resource.data.classId
        && isMember(request.resource.data.classId)
        && !exists(attendancePath(request.resource.data.sessionId, request.auth.uid));

      allow update: if
        // Keputusan asisten kelas: mengubah status + metadata review saja.
        (isClassAsisten(resource.data.classId)
          && resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'updatedAt'])
          && request.resource.data.status in ['APPROVED', 'REJECTED']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time)
        ||
        // Pemilik: hanya hasil klasifikasi AI (informasi pendukung); status tidak dapat disentuh.
        (signedIn()
          && resource.data.praktikanUid == request.auth.uid
          && resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['aiStatus', 'aiLabel', 'aiConfidence', 'aiRaw', 'updatedAt'])
          && validAiFields(request.resource.data)
          && request.resource.data.updatedAt == request.time);

      allow delete: if isClassAsisten(resource.data.classId);
    }

    // -------------------------------------------------------------- labs

    function validLabFields(data) {
      return data.keys().hasOnly(
               ['nama', 'gedung', 'deskripsi', 'latitude', 'longitude', 'radiusMeter', 'cosLat',
                'mataKuliah', 'classId', 'gracePeriodMinutes', 'fineAmount', 'asprakIds',
                'aslabIds', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(
               ['nama', 'gedung', 'deskripsi', 'latitude', 'longitude', 'radiusMeter', 'cosLat',
                'createdBy', 'createdAt', 'updatedAt'])
        && shortText(data.nama, 100)
        && shortText(data.gedung, 100)
        && data.deskripsi is string && data.deskripsi.size() <= 500
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.radiusMeter is number && data.radiusMeter >= 10 && data.radiusMeter <= 1000
        && data.cosLat is number && data.cosLat > 0 && data.cosLat <= 1
        && (!('mataKuliah' in data) || shortText(data.mataKuliah, 100))
        && (!('classId' in data) || data.classId == null || shortText(data.classId, 100))
        && (!('gracePeriodMinutes' in data)
            || (data.gracePeriodMinutes is number
                && data.gracePeriodMinutes >= 0 && data.gracePeriodMinutes <= 180))
        && (!('fineAmount' in data)
            || (data.fineAmount is number && data.fineAmount >= 0 && data.fineAmount <= 500000))
        && (!('asprakIds' in data) || data.asprakIds is list)
        && (!('aslabIds' in data) || data.aslabIds is list)
        && data.updatedAt == request.time;
    }

    match /labs/{labId} {
      allow read: if signedIn();

      allow create: if isAslab()
        && validLabFields(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isAslab()
        && validLabFields(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAslab();
    }

    // -------------------------------------------------------- labMembers

    function validLabMemberFields(data, memberId) {
      return data.keys().hasOnly(
               ['labId', 'uid', 'role', 'nama', 'nomorInduk', 'email', 'assignedBy',
                'assignedAt', 'updatedAt'])
        && data.keys().hasAll(
               ['labId', 'uid', 'role', 'nama', 'nomorInduk', 'email', 'assignedBy',
                'assignedAt', 'updatedAt'])
        && memberId == data.labId + '_' + data.uid
        && labExists(data.labId)
        && exists(profilePath(data.uid))
        && data.role in ['praktikan', 'asisten', 'aslab']
        && shortText(data.nama, 100)
        && shortText(data.nomorInduk, 30)
        && shortText(data.email, 320)
        && data.assignedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /labMembers/{memberId} {
      allow read: if isAslab()
        || isAsisten()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAslab()
        && validLabMemberFields(request.resource.data, memberId)
        && request.resource.data.assignedAt == request.time;

      allow update: if isAslab()
        && validLabMemberFields(request.resource.data, memberId)
        && request.resource.data.labId == resource.data.labId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.assignedBy == resource.data.assignedBy
        && request.resource.data.assignedAt == resource.data.assignedAt;

      allow delete: if isAslab();
    }

    // ------------------------------------------------------------- fines

    function validFineFields(data, id) {
      return data.keys().hasOnly(
               ['attendanceId', 'sessionId', 'classId', 'labId', 'sessionTitle', 'labName',
                'praktikanUid', 'amount', 'lateMinutes', 'status', 'latestOrderId',
                'latestPaymentStatus', 'issuedAt', 'paidAt', 'updatedAt'])
        && data.keys().hasAll(
               ['attendanceId', 'sessionId', 'classId', 'labId', 'sessionTitle', 'labName',
                'praktikanUid', 'amount', 'lateMinutes', 'status', 'latestOrderId',
                'latestPaymentStatus', 'issuedAt', 'paidAt', 'updatedAt'])
        && id == data.sessionId + '_' + data.praktikanUid
        && data.attendanceId == id
        && data.praktikanUid == request.auth.uid
        && shortText(data.sessionTitle, 150)
        && data.labName is string && data.labName.size() <= 100
        && (data.labId == null || shortText(data.labId, 100))
        && data.amount is number && data.amount > 0 && data.amount <= 500000
        && data.lateMinutes is number && data.lateMinutes >= 1
        && data.status == 'UNPAID'
        && data.latestOrderId == null
        && data.latestPaymentStatus == null
        && data.paidAt == null
        && data.issuedAt == request.time
        && data.updatedAt == request.time
        && exists(attendancePath(data.sessionId, data.praktikanUid))
        && get(attendancePath(data.sessionId, data.praktikanUid)).data.classId == data.classId;
    }

    match /fines/{fineId} {
      allow read: if isAslab()
        || (signedIn() && resource.data.praktikanUid == request.auth.uid)
        || isClassAsisten(resource.data.classId);

      allow create: if signedIn() && validFineFields(request.resource.data, fineId);
      allow update, delete: if false;
    }

    // ----------------------------------------------- paymentTransactions

    match /paymentTransactions/{orderId} {
      allow read: if isAslab()
        || (signedIn() && resource.data.praktikanUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------- pushTokens
    // ID = UID. Dibaca per dokumen oleh pemilik atau asisten (list ditolak agar token tidak bisa di-dump).

    function validPushTokenFields(data, uid) {
      return data.keys().hasOnly(['uid', 'token', 'platform', 'updatedAt'])
        && data.keys().hasAll(['uid', 'token', 'platform', 'updatedAt'])
        && data.uid == uid
        && shortText(data.token, 200)
        && data.platform in ['android', 'ios']
        && data.updatedAt == request.time;
    }

    match /pushTokens/{uid} {
      allow get: if isOwner(uid) || isAsisten();
      allow list: if false;

      allow create, update: if isOwner(uid)
        && validPushTokenFields(request.resource.data, uid);

      allow delete: if isOwner(uid);
    }

    // Deny-by-default untuk path lain.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
